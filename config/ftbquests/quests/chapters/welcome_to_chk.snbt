		{
			dependencies: ["364B6665BE417076"]
			description: [
				"There is 5 tiers of Villagers:"
				"- &ePeasants&r"
				"- &aWorkers&r"
				"- &5Artisans&r"
				"- &cScholars&r"
				"- &bExcellence&r"
				""
