				id: "4AD1772520E99713"
				item: "kubejs:contract"
				type: "item"
			}]
			shape: "rsquare"
			size: 2.0d
			subtitle: "Welcome to your own island!"
			tasks: [{
				id: "7D94A8E0C335D4AC"
				title: "Welcome to Create:Hell's Kitchen!"
